# Aris mako defaults (package-managed). Override in ~/.config/mako/config

font=Inter 11
width=380
height=160
margin=12
padding=14
border-size=2
border-radius=12
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark
default-timeout=6000
anchor=top-right
layer=overlay

background-color=#151821ee
text-color=#e4e7ef
border-color=#9d8cff
progress-color=over #2a2e3d

[urgency=low]
border-color=#2a2e3d

[urgency=critical]
border-color=#ff6b81
default-timeout=0
