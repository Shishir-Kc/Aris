#!/usr/bin/env bash
# aris-wallpaper [restore | <image>] — set the desktop wallpaper and remember it.
set -euo pipefail

state="${XDG_CONFIG_HOME:-$HOME/.config}/aris/wallpaper"
default=/usr/share/aris/wallpapers/aris-default.png

case "${1:-restore}" in
  -h | --help)
    echo "usage: aris-wallpaper [restore | <image>]"
    exit 0
    ;;
  restore)
    image="$(readlink -f -- "$state" 2>/dev/null || true)"
    [[ -n $image && -f $image ]] || image="$default"
    ;;
  *)
    image="$(realpath -- "$1")"
    [[ -f $image ]] || { echo "aris-wallpaper: no such file: $1" >&2; exit 1; }
    mkdir -p -- "${state%/*}"
    ln -sfn -- "$image" "$state"
    ;;
esac

pkill -x swaybg 2>/dev/null || true
setsid -f swaybg --mode fill --image "$image" >/dev/null 2>&1
