#!/usr/bin/env bash
# aris-wallpaper [<image>] — set the desktop and lock-screen wallpaper.
# With no argument, re-applies the current one. The choice is a symlink at
# ~/.config/aris/wallpaper that the Aris shell reads.
set -euo pipefail

state="${XDG_CONFIG_HOME:-$HOME/.config}/aris/wallpaper"

case "${1:-}" in
  -h | --help)
    echo "usage: aris-wallpaper [<image>]"
    exit 0
    ;;
  "" | restore) ;;
  *)
    image="$(realpath -- "$1")"
    [[ -f $image ]] || { echo "aris-wallpaper: no such file: $1" >&2; exit 1; }
    mkdir -p -- "${state%/*}"
    ln -sfn -- "$image" "$state"
    ;;
esac

aris-shell ipc call wallpaper reload >/dev/null 2>&1 || true
